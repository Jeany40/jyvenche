# Jyvenche | Digital Product Studio
# Copy this file to .env.local and fill in your details.

# --- STRIPE ---
# The URL for the payment link or specific invoice checkout page.
STRIPE_PAY_LINK_URL="https://buy.stripe.com/..."

# --- EMAIL (RESEND) ---
# Required for the inquiry form to send actual emails.
# Get yours at https://resend.com
RESEND_API_KEY=""

# The email address that will receive inquiry notifications.
SITE_OWNER_EMAIL="hello@yourdomain.com"

# The "From" address for sent emails (must be a verified domain in Resend).
FROM_EMAIL="Jyvenche <onboarding@resend.dev>"

# --- ANALYTICS ---
# (Optional) Add your tracking IDs here if integrating specialized scripts.
NEXT_PUBLIC_GA_ID=""
